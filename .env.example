# 仅站长使用：/admin 控制台的登录密钥，也用于生成/撤销一次性配对码和设备令牌。
# 绝不能写入 mod 或发给玩家。
# 至少 32 个随机字符；生产环境未配置时，/admin 和配对管理接口都会拒绝工作。
# 换掉这个值会立刻踢掉所有已登录的 /admin 浏览器会话。
CESTATS_ADMIN_KEY=

# 临时关闭客户端写入时设为 false；默认开启。
CESTATS_INGEST_ENABLED=true

# SQLite 文件位置，默认 <项目>/data/cestats.db
# CESTATS_DB=/var/lib/cestats/cestats.db

# 皮肤缓存目录，默认 <项目>/data/skins
# CESTATS_SKIN_CACHE=/var/lib/cestats/skins

# /download 页面列出的 mod jar 存放目录，默认 <项目>/data/mods
# 手动把 mod/dist/ 里的 jar 传到这里即可，页面自动读取，不需要重启
# CESTATS_MOD_DIR=/var/lib/cestats/mods

# 站点对外地址，用于 /api/ingest 返回的比赛链接
CESTATS_SITE_URL=http://127.0.0.1:3100

# --- docker compose 用（都可省略，括号内为默认值）---
# 宿主机监听地址和端口（127.0.0.1 / 3100）
CESTATS_BIND=127.0.0.1
CESTATS_PORT=3100
